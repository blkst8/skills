// Prisma schema for the dashboard Postgres database.
// Connection is configured via DATABASE_URL (see .env.example at the repo root).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Widget {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  type      String
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([type])
  @@map("widgets")
}
