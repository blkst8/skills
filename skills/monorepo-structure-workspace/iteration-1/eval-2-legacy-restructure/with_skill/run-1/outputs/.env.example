# No .env at the repo root — every app keeps its own environment file.
# This file documents the union of all variables and where each one lives.

# apps/api/.env (copy from apps/api/.env.example)
DATABASE_URL=postgresql://user:password@localhost:5432/legacydb
JWT_SECRET=change-me
PORT=4000
REDIS_URL=redis://localhost:6379

# apps/web/.env.local (copy from apps/web/.env.example)
# Vite only exposes VITE_-prefixed vars to client code.
VITE_API_URL=http://localhost:4000
API_URL=http://localhost:4000
